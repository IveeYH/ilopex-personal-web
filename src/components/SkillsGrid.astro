---
import type { SiteContent } from "../i18n/content";
import ExperienceReferences from "./ExperienceReferences.astro";

interface Props {
  skills: SiteContent["skills"];
  referenceLabel: string;
}

const { skills, referenceLabel } = Astro.props;
---

<div class="skills-grid">
  {
    skills.items.map((item, index) => (
      <article
        class:list={["card", "skill-card", { "skill-card--wide": index === 4 }]}
      >
        <p class="eyebrow">{item.category}</p>
        <h3>{item.technology}</h3>
        <p class="detail-label">{skills.applicationLabel}</p>
        <p>{item.application}</p>
        <ExperienceReferences
          label={referenceLabel}
          references={item.references}
        />
      </article>
    ))
  }
</div>
