---
import type { Locale } from "../i18n/config";
import { localePath } from "../i18n/config";
import { profile, type SiteContent } from "../i18n/content";
import LanguageSwitcher from "./LanguageSwitcher.astro";

interface Props {
  locale: Locale;
  copy: SiteContent;
}

const { locale, copy } = Astro.props;
const links = [
  ["#profile", copy.nav.profile],
  ["#capabilities", copy.nav.capabilities],
  ["#experience", copy.nav.experience],
  ["#skills", copy.nav.skills],
  ["#education", copy.nav.education],
  ["#contact", copy.nav.contact],
] as const;
---

<header class="site-header">
  <div class="site-header__bar content-width">
    <a class="brand" href={localePath(locale)}>{profile.name}</a>

    <nav class="desktop-nav" aria-label={copy.nav.label}>
      <ul role="list">
        {
          links.map(([href, label]) => (
            <li>
              <a href={href}>{label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="desktop-language">
      <LanguageSwitcher
        locale={locale}
        label={copy.nav.language}
        names={copy.nav.languageNames}
      />
    </div>

    <details class="mobile-menu">
      <summary aria-label={copy.a11y.openMenu}>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </summary>
      <div class="mobile-menu__panel">
        <div class="mobile-menu__top content-width">
          <a class="brand" href={localePath(locale)}>{profile.name}</a>
          <button
            type="button"
            class="mobile-menu__close"
            aria-label={copy.a11y.closeMenu}>×</button
          >
        </div>
        <div class="mobile-menu__content content-width">
          <p class="eyebrow">{copy.nav.menu}</p>
          <nav class="mobile-menu__nav" aria-label={copy.nav.label}>
            <ul role="list">
              {
                links.map(([href, label]) => (
                  <li>
                    <a href={href}>
                      {label}
                      <span aria-hidden="true">→</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <LanguageSwitcher
            locale={locale}
            label={copy.nav.language}
            names={copy.nav.languageNames}
          />
          <a class="mobile-menu__email" href={`mailto:${profile.email}`}
            >{profile.email}</a
          >
        </div>
      </div>
    </details>
  </div>
</header>

<script>
  document
    .querySelectorAll<HTMLDetailsElement>(".mobile-menu")
    .forEach((menu) => {
      menu
        .querySelector<HTMLButtonElement>(".mobile-menu__close")
        ?.addEventListener("click", () => {
          menu.open = false;
        });
      menu
        .querySelectorAll<HTMLAnchorElement>(".mobile-menu__panel a")
        .forEach((link) => {
          link.addEventListener("click", () => {
            menu.open = false;
          });
        });
    });
</script>
