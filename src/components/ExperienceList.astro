---
import type { SiteContent } from "../i18n/content";

interface Props {
  experience: SiteContent["experience"];
}

const { experience } = Astro.props;
---

<ol class="experience-list" role="list">
  {
    experience.items.map((item) => (
      <li>
        <article class="card experience-card">
          <header class="experience-card__header">
            <div>
              <h3>{item.role}</h3>
              <p>{item.company}</p>
            </div>
            <p class="period">{item.period}</p>
          </header>
          <dl class="experience-card__details experience-card__details--desktop">
            <div>
              <dt>{experience.labels.scope}</dt>
              <dd>{item.scope}</dd>
            </div>
            <div>
              <dt>{experience.labels.approach}</dt>
              <dd>{item.approach}</dd>
            </div>
            <div>
              <dt>{experience.labels.application}</dt>
              <dd>{item.application}</dd>
            </div>
          </dl>
          <dl class="experience-card__details experience-card__details--mobile">
            <div>
              <dt>{experience.labels.scope}</dt>
              <dd>{item.compactScope}</dd>
            </div>
            <div>
              <dt>{experience.labels.application}</dt>
              <dd>{item.compactApplication}</dd>
            </div>
          </dl>
          {item.note && <p class="experience-card__note">{item.note}</p>}
        </article>
      </li>
    ))
  }
</ol>
